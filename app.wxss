page {
  background: #f4f6f9;
  font-size: 28rpx;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx 24rpx 160rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 20rpx;
}

.muted {
  color: #8a8f99;
  font-size: 24rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.btn-primary {
  background: #2b6cb0;
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  line-height: 1.4;
}

.btn-ghost {
  background: #eef2f7;
  color: #2b6cb0;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  text-align: center;
  line-height: 1.4;
}

.field {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f2f5;
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 200rpx;
  color: #4b5563;
  font-size: 28rpx;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #111827;
}

.empty {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #2b6cb0;
  color: #ffffff;
  font-size: 56rpx;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(43, 108, 176, 0.35);
}

/* ===== 卡片式表单通用组件（车辆表单 / 记一笔 / 反馈 共用） ===== */

/* Hero 头图基础布局，主题色由 .theme-x .hero 提供 */
.hero {
  position: relative;
  overflow: hidden;
  padding: 48rpx 40rpx 112rpx;
  border-radius: 0 0 48rpx 48rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%);
  transition: background 0.3s ease;
}

.hero-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-dot-a {
  width: 280rpx;
  height: 280rpx;
  top: -110rpx;
  right: -70rpx;
}

.hero-dot-b {
  width: 180rpx;
  height: 180rpx;
  bottom: -60rpx;
  left: -40rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-badge {
  position: absolute;
  top: 44rpx;
  right: 40rpx;
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.hero-sub {
  position: relative;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.content {
  margin-top: -64rpx;
  padding: 0 24rpx;
}

.card-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.card-hint {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 输入框卡片行 */
.input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: #f7f9fc;
  border: 2rpx solid transparent;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.input-row.focus {
  background: #ffffff;
  border-color: #2563eb;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.1);
}

.input-row.focus-amount {
  background: #ffffff;
  border-color: rgba(15, 23, 42, 0.06);
  box-shadow: none;
}

.ico {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  border-radius: 20rpx;
  background: #eef4ff;
  line-height: 64rpx;
  text-align: center;
  font-size: 30rpx;
}

.ico-alt {
  background: #fff1e6;
}

.ico-warm {
  background: #ecfdf5;
}

.input-body {
  flex: 1;
  overflow: hidden;
}

.input-label {
  font-size: 22rpx;
  color: #8a8f99;
  margin-bottom: 4rpx;
}

.req {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #e0245e;
}

.input {
  width: 100%;
  height: 46rpx;
  font-size: 30rpx;
  color: #111827;
}

.ph {
  color: #c4cad3;
}

.block {
  margin-top: 26rpx;
}

.block-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 18rpx;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f7f9fc;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

/* 横向标签 */
.chips {
  width: 100%;
  white-space: nowrap;
  margin: 4rpx 0 8rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 28rpx;
  background: #f1f5f9;
  color: #4b5563;
  font-size: 24rpx;
}

.chip-active {
  background: #2563eb;
  color: #ffffff;
}

.chip-hover {
  opacity: 0.85;
}

.tip {
  padding: 0 18rpx 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.7;
}

/* 类型三/两选一卡片 */
.energy-grid {
  display: flex;
  flex-direction: row;
}

.energy-item {
  position: relative;
  flex: 1;
  margin-right: 16rpx;
  padding: 26rpx 10rpx 22rpx;
  border-radius: 22rpx;
  background: #f7f9fc;
  border: 2rpx solid transparent;
  text-align: center;
}

.energy-item:last-child {
  margin-right: 0;
}

.energy-item.active {
  background: #eff6ff;
  border-color: #2563eb;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.14);
}

.energy-hover {
  opacity: 0.9;
}

.energy-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 14rpx;
  border-radius: 26rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 38rpx;
}

.energy-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.energy-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.energy-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.energy-item.active .energy-check {
  opacity: 1;
}

/* 底部操作条 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.save-btn {
  padding: 24rpx 0;
  border-radius: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  box-shadow: 0 10rpx 24rpx rgba(29, 78, 216, 0.28);
}

.save-btn.disabled {
  opacity: 0.6;
}

.del-btn {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #e0245e;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.99);
}

/* 分段控件（统计页时间范围） */
.segment {
  display: flex;
  flex-direction: row;
  background: #eef2f7;
  border-radius: 32rpx;
  padding: 6rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  padding: 12rpx 0;
  border-radius: 28rpx;
}

.segment-item.active {
  background: #ffffff;
  color: #2b6cb0;
  font-weight: 500;
}

/* ===== 主题联动（燃油橙 / 纯电绿 / 混动蓝紫），默认蓝 ===== */
.theme-fuel .hero {
  background: linear-gradient(135deg, #fb923c 0%, #d9480f 100%);
}

.theme-charge .hero {
  background: linear-gradient(135deg, #34d399 0%, #047857 100%);
}

.theme-hybrid .hero {
  background: linear-gradient(135deg, #818cf8 0%, #4338ca 100%);
}

.theme-fuel .energy-item.active {
  background: #fff5ed;
  border-color: #ea580c;
  box-shadow: 0 8rpx 20rpx rgba(234, 88, 12, 0.16);
}

.theme-charge .energy-item.active {
  background: #ecfdf5;
  border-color: #059669;
  box-shadow: 0 8rpx 20rpx rgba(5, 150, 105, 0.16);
}

.theme-hybrid .energy-item.active {
  background: #eef2ff;
  border-color: #4f46e5;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.16);
}

.theme-fuel .energy-item.active .energy-check {
  background: #ea580c;
}

.theme-charge .energy-item.active .energy-check {
  background: #059669;
}

.theme-hybrid .energy-item.active .energy-check {
  background: #4f46e5;
}

.theme-fuel .input-row.focus {
  border-color: #ea580c;
  box-shadow: 0 6rpx 16rpx rgba(234, 88, 12, 0.1);
}

.theme-charge .input-row.focus {
  border-color: #059669;
  box-shadow: 0 6rpx 16rpx rgba(5, 150, 105, 0.1);
}

.theme-hybrid .input-row.focus {
  border-color: #4f46e5;
  box-shadow: 0 6rpx 16rpx rgba(79, 70, 229, 0.1);
}

.theme-fuel .chip-active {
  background: #ea580c;
}

.theme-charge .chip-active {
  background: #059669;
}

.theme-hybrid .chip-active {
  background: #4f46e5;
}

.theme-fuel .save-btn {
  background: linear-gradient(135deg, #fb923c 0%, #d9480f 100%);
  box-shadow: 0 10rpx 24rpx rgba(217, 72, 15, 0.28);
}

.theme-charge .save-btn {
  background: linear-gradient(135deg, #34d399 0%, #047857 100%);
  box-shadow: 0 10rpx 24rpx rgba(4, 120, 87, 0.28);
}

.theme-hybrid .save-btn {
  background: linear-gradient(135deg, #818cf8 0%, #4338ca 100%);
  box-shadow: 0 10rpx 24rpx rgba(67, 56, 202, 0.28);
}
