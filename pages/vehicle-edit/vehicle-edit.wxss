/* ===== 页面容器与主题联动 ===== */
.page {
  min-height: 100vh;
  padding: 0 0 300rpx;
  background: #f4f6f9;
}

/* ===== 顶部车牌预览 ===== */
.hero {
  position: relative;
  overflow: hidden;
  padding: 48rpx 40rpx 112rpx;
  border-radius: 0 0 48rpx 48rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%);
  transition: background 0.3s ease;
}

.theme-fuel .hero {
  background: linear-gradient(135deg, #fb923c 0%, #d9480f 100%);
}

.theme-charge .hero {
  background: linear-gradient(135deg, #34d399 0%, #047857 100%);
}

.theme-hybrid .hero {
  background: linear-gradient(135deg, #818cf8 0%, #4338ca 100%);
}

.hero-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-dot-a {
  width: 280rpx;
  height: 280rpx;
  top: -110rpx;
  right: -70rpx;
}

.hero-dot-b {
  width: 180rpx;
  height: 180rpx;
  bottom: -60rpx;
  left: -40rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-badge {
  position: absolute;
  top: 44rpx;
  right: 40rpx;
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.hero-main {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-top: 20rpx;
}

/* 车牌样式 */
.plate {
  padding: 12rpx 26rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.18);
}

.plate-blue {
  background: #1e40af;
  color: #ffffff;
}

.plate-green {
  background: linear-gradient(180deg, #f0fdf6 0%, #b7e9cd 100%);
  color: #0f172a;
  border-color: rgba(255, 255, 255, 0.85);
}

.plate-empty {
  opacity: 0.6;
}

.plate-text {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.hero-meta {
  margin-left: 24rpx;
  flex: 1;
  overflow: hidden;
}

.hero-name {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
}

/* ===== 内容区（上浮压住头图） ===== */
.content {
  margin-top: -64rpx;
  padding: 0 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.card-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.card-hint {
  font-size: 22rpx;
  color: #9ca3af;
}

/* ===== 能源类型三选一 ===== */
.energy-grid {
  display: flex;
  flex-direction: row;
}

.energy-item {
  position: relative;
  flex: 1;
  margin-right: 16rpx;
  padding: 26rpx 10rpx 22rpx;
  border-radius: 22rpx;
  background: #f7f9fc;
  border: 2rpx solid transparent;
  text-align: center;
}

.energy-item:last-child {
  margin-right: 0;
}

.energy-item.active {
  background: #eff6ff;
  border-color: #2563eb;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.14);
}

.theme-fuel .energy-item.active {
  background: #fff5ed;
  border-color: #ea580c;
  box-shadow: 0 8rpx 20rpx rgba(234, 88, 12, 0.16);
}

.theme-charge .energy-item.active {
  background: #ecfdf5;
  border-color: #059669;
  box-shadow: 0 8rpx 20rpx rgba(5, 150, 105, 0.16);
}

.theme-hybrid .energy-item.active {
  background: #eef2ff;
  border-color: #4f46e5;
  box-shadow: 0 8rpx 20rpx rgba(79, 70, 229, 0.16);
}

.energy-hover {
  opacity: 0.9;
}

.energy-icon {
  width: 76rpx;
  height: 76rpx;
  margin: 0 auto 14rpx;
  border-radius: 26rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 38rpx;
}

.energy-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.energy-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9ca3af;
}

.energy-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.energy-item.active .energy-check {
  opacity: 1;
}

.theme-fuel .energy-item.active .energy-check {
  background: #ea580c;
}

.theme-charge .energy-item.active .energy-check {
  background: #059669;
}

.theme-hybrid .energy-item.active .energy-check {
  background: #4f46e5;
}

/* ===== 输入行 ===== */
.input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 18rpx;
  border-radius: 20rpx;
  background: #f7f9fc;
  border: 2rpx solid transparent;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.input-row.focus {
  background: #ffffff;
  border-color: #2563eb;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.1);
}

.theme-fuel .input-row.focus {
  border-color: #ea580c;
  box-shadow: 0 6rpx 16rpx rgba(234, 88, 12, 0.1);
}

.theme-charge .input-row.focus {
  border-color: #059669;
  box-shadow: 0 6rpx 16rpx rgba(5, 150, 105, 0.1);
}

.theme-hybrid .input-row.focus {
  border-color: #4f46e5;
  box-shadow: 0 6rpx 16rpx rgba(79, 70, 229, 0.1);
}

.ico {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  border-radius: 20rpx;
  background: #eef4ff;
  line-height: 64rpx;
  text-align: center;
  font-size: 30rpx;
}

.ico-alt {
  background: #fff1e6;
}

.ico-warm {
  background: #ecfdf5;
}

.input-body {
  flex: 1;
  overflow: hidden;
}

.input-label {
  font-size: 22rpx;
  color: #8a8f99;
  margin-bottom: 4rpx;
}

.req {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #e0245e;
}

.input {
  width: 100%;
  height: 46rpx;
  font-size: 30rpx;
  color: #111827;
}

.ph {
  color: #c4cad3;
}

/* ===== 品牌快捷标签 ===== */
.chips {
  width: 100%;
  white-space: nowrap;
  margin: 4rpx 0 8rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 28rpx;
  background: #f1f5f9;
  color: #4b5563;
  font-size: 24rpx;
}

.chip-active {
  background: #2563eb;
  color: #ffffff;
}

.theme-fuel .chip-active {
  background: #ea580c;
}

.theme-charge .chip-active {
  background: #059669;
}

.theme-hybrid .chip-active {
  background: #4f46e5;
}

.chip-hover {
  opacity: 0.85;
}

/* ===== 颜色 / 备注 ===== */
.block {
  margin-top: 26rpx;
}

.block-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 18rpx;
}

.swatches {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.swatch {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  margin: 0 20rpx 20rpx 0;
  border-radius: 32rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.08);
}

.swatch-ring {
  position: absolute;
  top: -9rpx;
  left: -9rpx;
  right: -9rpx;
  bottom: -9rpx;
  border-radius: 40rpx;
  border: 3rpx solid #2563eb;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.swatch-active .swatch-ring {
  opacity: 1;
}

.theme-fuel .swatch-ring {
  border-color: #ea580c;
}

.theme-charge .swatch-ring {
  border-color: #059669;
}

.theme-hybrid .swatch-ring {
  border-color: #4f46e5;
}

.input-plain {
  height: 44rpx;
  padding: 0 4rpx;
  font-size: 26rpx;
  color: #111827;
  border-bottom: 2rpx solid #eef2f7;
}

.textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f7f9fc;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

/* ===== 提示 ===== */
.tip {
  padding: 0 18rpx 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.7;
}

/* ===== 底部操作条 ===== */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.save-btn {
  padding: 24rpx 0;
  border-radius: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
  box-shadow: 0 10rpx 24rpx rgba(29, 78, 216, 0.28);
}

.theme-fuel .save-btn {
  background: linear-gradient(135deg, #fb923c 0%, #d9480f 100%);
  box-shadow: 0 10rpx 24rpx rgba(217, 72, 15, 0.28);
}

.theme-charge .save-btn {
  background: linear-gradient(135deg, #34d399 0%, #047857 100%);
  box-shadow: 0 10rpx 24rpx rgba(4, 120, 87, 0.28);
}

.theme-hybrid .save-btn {
  background: linear-gradient(135deg, #818cf8 0%, #4338ca 100%);
  box-shadow: 0 10rpx 24rpx rgba(67, 56, 202, 0.28);
}

.save-btn.disabled {
  opacity: 0.6;
}

.del-btn {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #e0245e;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.99);
}
