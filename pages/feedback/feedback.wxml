<view class="page">
  <view class="hero">
    <view class="hero-dot hero-dot-a"></view>
    <view class="hero-dot hero-dot-b"></view>
    <view class="hero-badge">{{typeIcon}} {{typeName}}</view>
    <view class="hero-title">意见反馈</view>
    <view class="hero-sub">你的建议让这个小程序的更好用</view>
  </view>

  <view class="content">
    <view class="card">
      <view class="card-head">
        <text class="card-title">反馈类型</text>
      </view>
      <view class="energy-grid">
        <view
          wx:for="{{typeTabs}}"
          wx:key="value"
          class="energy-item {{feedbackType === item.value ? 'active' : ''}}"
          hover-class="energy-hover"
          data-value="{{item.value}}"
          bindtap="onTypeSelect"
        >
          <view class="energy-icon" style="background: {{item.bg}}">{{item.icon}}</view>
          <text class="energy-label">{{item.label}}</text>
          <text class="energy-desc">{{item.desc}}</text>
          <view class="energy-check">✓</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <text class="card-title">反馈内容</text>
        <text class="card-hint">必填</text>
      </view>
      <view class="input-row {{focusKey === 'content' ? 'focus' : ''}}">
        <textarea
          class="textarea"
          placeholder="说说你的想法：哪里不好用、想要什么功能、遇到了什么问题…"
          placeholder-class="ph"
          value="{{content}}"
          data-key="content"
          bindinput="onInput"
          bindfocus="onFocus"
          bindblur="onBlur"
          maxlength="500"
          auto-height="{{true}}"
          cursor-spacing="40"
        />
      </view>
    </view>

    <view class="card">
      <view class="card-head">
        <text class="card-title">联系方式</text>
        <text class="card-hint">选填，方便回复你</text>
      </view>
      <view class="input-row {{focusKey === 'contact' ? 'focus' : ''}}">
        <view class="ico ico-warm">📮</view>
        <view class="input-body">
          <view class="input-label">微信 / 手机号 / 邮箱</view>
          <input
            class="input"
            placeholder="选填"
            placeholder-class="ph"
            value="{{contact}}"
            data-key="contact"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
            maxlength="50"
          />
        </view>
      </view>
    </view>

    <view class="tip">反馈仅记录提交者本人可见，不会泄露给其他用户。</view>
  </view>

  <view class="footer">
    <view class="save-btn {{submitting ? 'disabled' : ''}}" hover-class="btn-hover" bindtap="onSubmit">
      {{submitting ? '提交中…' : '提交反馈'}}
    </view>
  </view>
</view>
