/* 页面容器（覆盖全局 .page 的 padding） */
.page {
  min-height: 100vh;
  padding: 0 0 300rpx;
  background: #f4f6f9;
}

/* Hero 装饰与内容 */
.hero-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-dot-a {
  width: 280rpx;
  height: 280rpx;
  top: -110rpx;
  right: -70rpx;
}

.hero-dot-b {
  width: 180rpx;
  height: 180rpx;
  bottom: -60rpx;
  left: -40rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-badge {
  position: absolute;
  top: 44rpx;
  right: 40rpx;
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.hero-amount {
  position: relative;
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 76rpx;
  font-weight: 600;
  line-height: 1.15;
}

.hero-sub {
  position: relative;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

/* 车辆横向卡片选择 */
.veh-scroll {
  width: 100%;
  white-space: nowrap;
}

.veh-row {
  display: inline-flex;
  flex-direction: row;
  padding: 4rpx 0;
}

.veh-card {
  position: relative;
  display: inline-block;
  width: 200rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: #f7f9fc;
  border: 2rpx solid transparent;
}

.veh-card.active {
  background: #ffffff;
  border-color: #2563eb;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.16);
}

.theme-fuel .veh-card.active {
  border-color: #ea580c;
  box-shadow: 0 8rpx 20rpx rgba(234, 88, 12, 0.16);
}

.theme-charge .veh-card.active {
  border-color: #059669;
  box-shadow: 0 8rpx 20rpx rgba(5, 150, 105, 0.16);
}

.veh-hover {
  opacity: 0.9;
}

.veh-dot {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.08);
}

.veh-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 10rpx;
  padding-right: 30rpx;
}

.veh-plate {
  font-size: 24rpx;
  color: #6b7280;
  letter-spacing: 1rpx;
}

.empty-hint {
  padding: 24rpx 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 金额大输入框 */
.amount-input {
  width: 100%;
  height: 80rpx;
  font-size: 56rpx;
  font-weight: 600;
  color: #111827;
}
