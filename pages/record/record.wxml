<view class="page theme-{{form.type}}">
  <!-- 顶部：金额实时预览 -->
  <view class="hero">
    <view class="hero-dot hero-dot-a"></view>
    <view class="hero-dot hero-dot-b"></view>
    <view class="hero-badge">{{typeIcon}} {{typeName}}</view>
    <view class="hero-amount">¥{{form.amount || '0.00'}}</view>
    <view class="hero-sub">{{vehicles.length ? vehicles[vehicleIndex].name : '请选择车辆'}} · {{recordDate}} {{recordTime}}</view>
  </view>

  <view class="content">
    <!-- 选择车辆 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">选择车辆</text>
        <text class="card-hint">{{vehicles.length}} 辆</text>
      </view>
      <scroll-view wx:if="{{vehicles.length}}" class="veh-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
        <view class="veh-row">
          <view
            wx:for="{{vehicles}}"
            wx:key="id"
            class="veh-card {{vehicleIndex === index ? 'active' : ''}}"
            hover-class="veh-hover"
            data-index="{{index}}"
            bindtap="onVehicleSelect"
          >
            <view class="veh-dot" wx:if="{{item.colorDot}}" style="background: {{item.colorDot}}"></view>
            <view class="veh-name">{{item.name}}</view>
            <view class="veh-plate">{{item.plate}}</view>
          </view>
        </view>
      </scroll-view>
      <view wx:else class="empty-hint">还没有车辆，先去「车辆」页添加一辆车</view>
    </view>

    <!-- 记录类型 + 金额 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">记录类型</text>
      </view>
      <view class="energy-grid">
        <view
          wx:for="{{typeTabs}}"
          wx:key="value"
          class="energy-item {{form.type === item.value ? 'active' : ''}}"
          hover-class="energy-hover"
          data-value="{{item.value}}"
          bindtap="onTypeSelect"
        >
          <view class="energy-icon" style="background: {{item.bg}}">{{item.icon}}</view>
          <text class="energy-label">{{item.label}}</text>
          <text class="energy-desc">{{item.desc}}</text>
          <view class="energy-check">✓</view>
        </view>
      </view>
      <view class="input-row focus-amount">
        <view class="input-body">
          <view class="input-label">金额（元）<text class="req">必填</text></view>
          <input
            class="amount-input"
            type="digit"
            placeholder="0.00"
            placeholder-class="ph"
            value="{{form.amount}}"
            data-key="amount"
            bindinput="onInput"
          />
        </view>
      </view>
    </view>

    <!-- 加油 / 充电明细 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">加油 / 充电明细</text>
        <text class="card-hint">选填</text>
      </view>

      <view class="input-row {{focusKey === 'quantity' ? 'focus' : ''}}">
        <view class="ico ico-warm">{{form.type === 'charge' ? '🔌' : '⛽'}}</view>
        <view class="input-body">
          <view class="input-label">{{form.type === 'charge' ? '充电量（度）' : '加油量（升）'}}</view>
          <input
            class="input"
            type="digit"
            placeholder="0.00"
            placeholder-class="ph"
            value="{{form.quantity}}"
            data-key="quantity"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
            maxlength="10"
          />
        </view>
      </view>

      <view class="input-row {{focusKey === 'unit_price' ? 'focus' : ''}}">
        <view class="ico">🏷️</view>
        <view class="input-body">
          <view class="input-label">单价（{{form.type === 'charge' ? '元/度' : '元/升'}}）</view>
          <input
            class="input"
            type="digit"
            placeholder="留空自动计算"
            placeholder-class="ph"
            value="{{form.unit_price}}"
            data-key="unit_price"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
            maxlength="10"
          />
        </view>
      </view>

      <view class="input-row {{focusKey === 'odometer' ? 'focus' : ''}}">
        <view class="ico ico-alt">📍</view>
        <view class="input-body">
          <view class="input-label">里程（km）</view>
          <input
            class="input"
            type="number"
            placeholder="选填"
            placeholder-class="ph"
            value="{{form.odometer}}"
            data-key="odometer"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
            maxlength="10"
          />
        </view>
      </view>
    </view>

    <!-- 更多 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">更多</text>
        <text class="card-hint">选填</text>
      </view>

      <view class="input-row {{focusKey === 'station' ? 'focus' : ''}}">
        <view class="ico ico-warm">🏪</view>
        <view class="input-body">
          <view class="input-label">{{form.type === 'charge' ? '充电站' : '加油站'}}</view>
          <input
            class="input"
            placeholder="选填"
            placeholder-class="ph"
            value="{{form.station}}"
            data-key="station"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
            maxlength="30"
          />
        </view>
      </view>

      <view class="input-row {{focusKey === 'location' ? 'focus' : ''}}">
        <view class="ico">🗺️</view>
        <view class="input-body">
          <view class="input-label">地点</view>
          <input
            class="input"
            placeholder="选填"
            placeholder-class="ph"
            value="{{form.location}}"
            data-key="location"
            bindinput="onInput"
            bindfocus="onFocus"
            bindblur="onBlur"
            maxlength="30"
          />
        </view>
      </view>

      <view class="input-row">
        <view class="ico ico-alt">📅</view>
        <view class="input-body">
          <view class="input-label">日期</view>
          <picker mode="date" value="{{recordDate}}" bindchange="onDateChange">
            <view class="input">{{recordDate}}</view>
          </picker>
        </view>
      </view>

      <view class="input-row">
        <view class="ico">⏰</view>
        <view class="input-body">
          <view class="input-label">时间</view>
          <picker mode="time" value="{{recordTime}}" bindchange="onTimeChange">
            <view class="input">{{recordTime}}</view>
          </picker>
        </view>
      </view>

      <view class="block">
        <view class="block-label">备注</view>
        <textarea
          class="textarea"
          placeholder="写点什么？比如这次加的 95 号油、充电前剩 20%…"
          placeholder-class="ph"
          value="{{form.note}}"
          data-key="note"
          bindinput="onInput"
          maxlength="120"
          auto-height="{{true}}"
          cursor-spacing="40"
        />
      </view>
    </view>

    <view class="tip">记录按车辆归属，仅你自己可见。</view>
  </view>

  <!-- 底部操作条 -->
  <view class="footer">
    <view class="save-btn {{saving ? 'disabled' : ''}}" hover-class="btn-hover" bindtap="onSave">
      {{saving ? '保存中…' : (isEdit ? '保存修改' : '保存记录')}}
    </view>
    <view wx:if="{{isEdit}}" class="del-btn" hover-class="btn-hover" bindtap="onDelete">删除这条记录</view>
  </view>
</view>
