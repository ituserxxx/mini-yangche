<view class="page">
  <view class="section-title">我的车辆</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>

  <view wx:elif="{{!vehicles.length}}" class="empty">
    <view>还没有添加车辆</view>
    <view class="muted">点右下角 + 添加第一辆车</view>
  </view>

  <view wx:else>
    <view class="card vehicle-item" wx:for="{{vehicles}}" wx:key="id" data-id="{{item.id}}" bindtap="onEdit">
      <view class="row-between">
        <view class="row">
          <view wx:if="{{item.colorDot}}" class="color-dot" style="background: {{item.colorDot}}"></view>
          <view>
            <view class="vehicle-name">{{item.name}}</view>
            <view class="muted">{{item.plate}}<text wx:if="{{item.brand_model}}"> · {{item.brand_model}}</text></view>
          </view>
        </view>
        <view class="tag">{{item.energyText}}</view>
      </view>
    </view>
  </view>

  <view class="fab" bindtap="onAdd">+</view>
</view>
